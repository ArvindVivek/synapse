{
  "name": "synapse-etl",
  "version": "1.0.0",
  "description": "ETL scripts for League of Legends data from GRID.gg",
  "type": "module",
  "scripts": {
    "etl": "tsx etl-lol.ts",
    "etl:dry-run": "tsx etl-lol.ts --dry-run",
    "etl:lck": "tsx etl-lol.ts --region=lck",
    "etl:lec": "tsx etl-lol.ts --region=lec",
    "etl:lcs": "tsx etl-lol.ts --region=lcs",
    "etl:lpl": "tsx etl-lol.ts --region=lpl",
    "etl:lta": "tsx etl-lol.ts --region=lta",
    "etl:test": "tsx etl-lol.ts --series-limit=3",
    "test:api": "tsx test-series-state.ts",
    "test:endstate": "tsx test-end-state.ts",
    "inspect:structure": "tsx inspect-end-state-structure.ts",
    "verify": "tsx verify-data.ts",
    "inspect": "tsx inspect-grid-response.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "adm-zip": "^0.5.10",
    "bottleneck": "^2.19.5",
    "dotenv": "^16.4.7",
    "p-retry": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
