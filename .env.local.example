# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/_/settings/api

# Project URL (found in Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Anonymous/Public Key (found in Project Settings -> API -> anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (found in Project Settings -> API -> service_role key)
# WARNING: This key has admin privileges. Never expose it in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GRID API Configuration
# Get your API key from: GRID Partner Portal -> API Keys

# GRID API Key for accessing tournament data
GRID_API_KEY=your-grid-api-key
